# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# To switch between LOCAL and PRODUCTION:
# 1. Comment out the current active section
# 2. Uncomment the section you want to use
# 3. Restart your dev server: npm run dev
# ============================================

# ============================================
# LOCAL DEVELOPMENT (localhost:8087)
# ============================================
# NEXT_PUBLIC_API_URL=http://localhost:8087/api/v1/apr/admin
# NEXT_PUBLIC_IMAGE_URL=http://localhost:8087/uploads
# NEXT_PUBLIC_LOGIN_URL=http://localhost:8087/login

# ============================================
# PRODUCTION (pri.arunachal.gov.in)
# ============================================
NEXT_PUBLIC_API_URL=https://www.pri.arunachal.gov.in/api/v1/apr/admin
NEXT_PUBLIC_IMAGE_URL=https://www.pri.arunachal.gov.in/uploads
NEXT_PUBLIC_LOGIN_URL=https://www.pri.arunachal.gov.in/admin/login
